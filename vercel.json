{
  "headers": [
    {
      "source": "/(.*)\\.txt",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(index\\.html|catalog\\.json|search-index\\.json|catalog-summary\\.json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "comment": "The worker script must never be served from cache, or a stale worker can pin itself and shadow every future deploy.",
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ]
}
